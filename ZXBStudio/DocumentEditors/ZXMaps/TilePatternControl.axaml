<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:svg="using:Avalonia.Svg.Skia"
			 x:Class="ZXBasicStudio.DocumentEditors.ZXMaps.TilePatternControl"
			 Margin="1">
	<Border Name="brdMain" BorderBrush="Transparent" BorderThickness="1">
		<Grid>
			<Canvas Name="cnvPoints"  Background="#c0c0c0"></Canvas>
			<TextBlock Name="lblNumber" Foreground="Blue" Margin="2,0"
				HorizontalAlignment="Left" VerticalAlignment="Top" 
				IsVisible="False" FontWeight="Bold"/>
			<Button Classes="toolbar" Name="btnNew" ToolTip.Tip="Add Tile" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
				<svg:Svg Path="/Svg/add.svg"></svg:Svg>
			</Button>
		</Grid>
	</Border>
</UserControl>
